# Face Recognition System - Criminal Identification
# Copy the relevant values into backend/system environment variables and frontend/.env as needed.

# ---------------- Backend security ----------------
# Strongly recommended in production. If omitted, the backend creates a machine-local secret.
FRS_JWT_SECRET=
FRS_JWT_ALGORITHM=HS256
FRS_ACCESS_TOKEN_MINUTES=60
FRS_RESET_TOKEN_MINUTES=20
FRS_LOGIN_MAX_ATTEMPTS=5
FRS_LOGIN_WINDOW_SECONDS=300

# Fernet key used to encrypt JSON secrets such as RTSP URLs and SMTP passwords.
# Generate once and retain securely for the deployment. If omitted, a machine-local .data_key is created.
FRS_DATA_ENCRYPTION_KEY=

# Restrict browser/Electron origins for the environment.
FRS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,file://,null

# Upload limits.
FRS_MAX_IMAGE_UPLOAD_MB=12
FRS_MAX_VIDEO_UPLOAD_MB=1024

# ---------------- Recognition safety guardrails ----------------
# These are ceilings/floors, not looser tuning knobs. Detection can still see
# small/far faces, but naming and evidence saving wait for stronger information.
FRS_RECOGNITION_MAX_TOLERANCE=0.50
FRS_LONG_RANGE_MAX_TOLERANCE=0.52
FRS_MIN_IDENTITY_FACE_PX=56
FRS_KNOWN_EVIDENCE_MIN_FACE_PX=72
FRS_UNKNOWN_EVIDENCE_MIN_FACE_PX=48
FRS_KNOWN_EVIDENCE_COOLDOWN=30
FRS_UNKNOWN_EVIDENCE_COOLDOWN=20

# JSON-first deployment -> SQLite migration snapshot.
FRS_AUTO_MIGRATE_JSON=1
# Synchronize old augmented identity folders into the live gallery, max 50 refs/person.
FRS_AUTO_BACKFILL_GALLERY=1

# Unsafe/legacy interfaces stay disabled unless explicitly required for migration/testing.
FRS_ENABLE_LEGACY_DIRECT_STREAM=0
FRS_ENABLE_LEGACY_WEBRTC_CONNECT=0
FRS_ENABLE_LEGACY_EVENT_INGESTION=0

# Never expose reset tokens in production. Only enable in isolated development.
FRS_DEV_SHOW_RESET_TOKEN=0

# ---------------- Electron / frontend ----------------
API_BASE_URL=http://127.0.0.1:8005
REACT_APP_API_BASE_URL=http://127.0.0.1:8005

# Optional login animation/media. Put the file under frontend/public/assets/.
# Supports gif/png/jpg/webp/avif or a looping video (mov/mp4/webm).
# REACT_APP_LOGIN_MEDIA=/assets/company-login.gif

# ---------------- Backup & recovery ----------------
# auto  = prefer Redis and automatically fall back to local application backup.
# redis = Redis is mandatory; backup requests fail if Redis is unavailable.
# local = back up JSON/SQLite/gallery state directly; Redis is not required.
FRS_BACKUP_MODE=auto
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Alternatively provide one URL instead of REDIS_HOST/PORT/DB:
# REDIS_URL=redis://127.0.0.1:6379/0
